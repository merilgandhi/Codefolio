# Copy this file to .env. Leave MONGODB_URI blank to run the foundation without a database.
PORT=4000
# Optional. Development defaults to 127.0.0.1; production defaults to 0.0.0.0.
HOST=127.0.0.1
NODE_ENV=development
MONGODB_URI=
APP_ORIGIN=http://127.0.0.1:5174
# Set only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
# Local example: mongodb://127.0.0.1:27017/codefolio
# Alternatively use your own MongoDB Atlas connection string. Never commit credentials.

# Production email uses the Gmail API over HTTPS. Keep OAuth credentials secret.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional; if set, it must exactly match GMAIL_USER.
GMAIL_FROM=
# Local SMTP fallback for development only. Render Free blocks SMTP ports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional local OAuth callback port for `npm run gmail:oauth`.
GMAIL_OAUTH_CALLBACK_PORT=48123
